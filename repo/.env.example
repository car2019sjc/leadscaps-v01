# copie para .env e preencha. O .env NÃO vai para o Git.
POSTGRES_DB=leadscaps
POSTGRES_USER=leadscaps
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# domínio apontando para a VPS — necessário para o HTTPS do Caddy
DOMINIO_API=api.seudominio.com.br

# origem do frontend no Netlify; separe por vírgula se houver mais de uma
ORIGENS_PERMITIDAS=https://leadscaps.netlify.app

# segredo do JWT — gere com:  openssl rand -base64 48
JWT_SECRET=

# chaves que saem do navegador e passam a viver só aqui
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
